import Foundation
import SwiftData

// Built as a separate executable with the release app module name, never in the current test module.
@main
struct FixtureGenerator {
    @MainActor static func main() throws {
        let directory = URL(fileURLWithPath: CommandLine.arguments[1], isDirectory: true)
        let populated = CommandLine.arguments[2] == "populated"
        let mode = CommandLine.arguments[2]
        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: false)
        let schema = Schema([Account.self, FinancialTransaction.self, Category.self, Tag.self, Shortcut.self])
        let config = ModelConfiguration(schema: schema, url: directory.appendingPathComponent("AI_Accounting_v3.store"), cloudKitDatabase: .none)
        let container = try ModelContainer(for: schema, configurations: [config])
        if populated {
            let cash = Account(id: id(1), name: "Synthetic cash", currency: "HKD", type: .cash, baseBalance: decimal("1000.00"))
            let category = Category(id: id(2), name: "Synthetic food", icon: "fork.knife", colorHex: "#123456")
            let tag = Tag(id: id(3), name: "Synthetic fixture")
            let expense = FinancialTransaction(id: id(4), amount: decimal("-35.59"), currencyCode: "HKD", date: date, note: "Synthetic expense", type: .expense, account: cash, category: category, tags: [tag])
            let shortcut = Shortcut(id: id(5), name: "Synthetic shortcut", icon: "fork.knife", amount: decimal("35.59"), type: .expense, note: "Synthetic shortcut", account: cash, category: category, tags: [tag])
            let bank = Account(id: id(6), name: "Synthetic USD bank", currency: "USD", type: .bank, baseBalance: decimal("50.00"), sortOrder: 1)
            let income = FinancialTransaction(id: id(7), amount: decimal("250.00"), currencyCode: "HKD", date: date, note: "Synthetic income", type: .income, account: cash)
            let outgoing = FinancialTransaction(id: id(8), amount: decimal("-100.00"), currencyCode: "HKD", date: date, note: "Synthetic transfer out", type: .transfer, linkedTransactionID: id(9), account: cash)
            let incoming = FinancialTransaction(id: id(9), amount: decimal("12.80"), currencyCode: "USD", date: date, note: "Synthetic transfer in", type: .transfer, linkedTransactionID: id(8), account: bank)
            for model in [cash as any PersistentModel, category, tag, expense, shortcut, bank, income, outgoing, incoming] {
                container.mainContext.insert(model)
            }
        }
        try container.mainContext.save()
        let metadata: [String: Any] = ["mode": mode, "runtime": ProcessInfo.processInfo.operatingSystemVersionString,
                                       "transactionCount": try container.mainContext.fetchCount(FetchDescriptor<FinancialTransaction>())]
        try JSONSerialization.data(withJSONObject: metadata, options: [.sortedKeys, .prettyPrinted]).write(to: directory.appendingPathComponent("generation.json"))
    }

    static var date: Date { Date(timeIntervalSince1970: 1700000000) }
    static func decimal(_ value: String) -> Decimal { Decimal(string: value, locale: Locale(identifier: "en_US_POSIX"))! }
    static func id(_ value: Int) -> UUID { UUID(uuidString: String(format: "00000000-0000-0000-0000-%012d", value))! }
}

      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此值用於代墊追蹤；借貸實際帳務仍以轉帳紀錄為準。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

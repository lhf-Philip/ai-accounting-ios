    "1. %@ 將增加 %@ %@ (資產)": {
      "comment": "A label describing a financial transaction where one account's balance increases by a certain amount in a specific currency, indicating an increase in assets. The first argument is the name of the account that will increase in balance. The second argument is the currency code. The third argument is the formatted amount.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "1. %1$@ will increase %2$@ %3$@ (assets)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1. %1$@ により %2$@ %3$@ (資産) が増加します"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. %1$@ 将增加 %2$@ %3$@ (资产)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1. %@ 將增加 %@ %@ (資產)"
          }
        }
      }
    },
    "1. %@ 將減少 %@ %@ (資產)": {
      "comment": "A label describing a financial transaction where one account's asset value is decreased by a certain amount, and another account's liability value is increased by the same amount. The first argument is the name of the account that will have its asset value decreased. The second argument is the formatted amount of currency that will be deducted from that account.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "1. %1$@ will be reduced by %2$@ %3$@ (asset)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1. %1$@ は %2$@ %3$@ (資産) によって削減されます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. %1$@ 将减少 %2$@ %3$@ (资产)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1. %@ 將減少 %@ %@ (資產)"
          }
        }
      }
    },
    "2. %@ 將增加 %@ %@ (負債)": {
      "comment": "A label indicating that a transaction will increase a negative balance (debt) on one account and decrease a positive balance (asset) on another account.",

    "1. %@ 將增加 %@ %@ (資產)" : {
      "comment" : "A label describing a financial transaction where one account's balance increases by a certain amount in a specific currency, indicating an increase in assets. The first argument is the name of the account that will increase in balance. The second argument is the currency code. The third argument is the formatted amount.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "1. %1$@ 將增加 %2$@ %3$@ (資產)"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. %1$@ will increase %2$@ %3$@ (assets)"

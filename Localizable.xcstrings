    "系統將自動建立一筆從「%@」轉入「%@」的 %@ %@ 交易。": {
      "comment": "A message that appears when a user adds a debt to their account, explaining that a corresponding transaction will be automatically created to settle the debt. The first argument is the string “”. The second argument is the name of the account that the debt is being settled into. The third argument is the string “HKD”. The fourth argument is the absolute value of the debt as a formatted currency amount.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The system will automatically create a %3$@ %4$@ transaction from \"%1$@\" to \"%2$@\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムは、「%1$@」から「%2$@」までの %3$@ %4$@ トランザクションを自動的に作成します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统将自动建立一笔从「%1$@」转入「%2$@」的 %3$@ %4$@ 交易。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統將自動建立一筆從「%@」轉入「%@」的 %@ %@ 交易。"
          }
        }
      }
    },
    "系統將自動建立一筆從「%@」轉出給「%@」的 %@ %@ 交易。": {
      "comment": "A text describing a system-generated transaction that automatically creates when a user adds a debt account. The first argument is the name of the account that the debt is being paid from. The second argument is the string “”. The third argument is the string “HKD”. The fourth argument is the absolute value of the debt as a formatted currency amount.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The system will automatically create a %3$@ %4$@ transaction from \"%1$@\" to \"%2$@\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムは、「%1$@」から「%2$@」までの %3$@ %4$@ トランザクションを自動的に作成します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统将自动建立一笔从「%1$@」转出给「%2$@」的 %3$@ %4$@ 交易。"

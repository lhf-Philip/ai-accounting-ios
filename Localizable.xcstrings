        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. %1$@ will be reduced by %2$@ %3$@ (asset)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. %1$@ は %2$@ %3$@ (資産) によって削減されます"
